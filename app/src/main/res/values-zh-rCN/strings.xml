    <string name="dxwrapper_help_content"><![CDATA[
        <i><b>WineD3D</b></i> 是把 DirectX 1–11 转成 OpenGL 的转译层。<br /><br />
        <i><b>DXVK</b></i> 是把 Direct3D 9–11 转成 Vulkan 的转译层。<br /><br />
        <i><b>VKD3D</b></i> 是把 Direct3D 12 转成 Vulkan 的转译层。
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_safeflags"><![CDATA[
        CALL/RET 指令的标志位处理<br /><br />
        <b>0</b>：把 CALL/RET 当作不需要标志位（更快，不稳定）<br />
        <b>1</b>：大多数 RET 需要标志位，大多数 CALL 不需要<br />
        <b>2</b>：所有 CALL/RET 都需要标志位（更慢）
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_fastnan">按 x86 方式生成 -NAN</string>
    <string name="box86_64_env_var_help__dynarec_fastround">生成精确的 x86 舍入</string>
    <string name="box86_64_env_var_help__dynarec_x87double">用 Float/Double 模拟 x87</string>
    <string name="box86_64_env_var_help__dynarec_bigblock"><![CDATA[
        动态重编译的大代码块构建<br /><br />
        <b>0</b>：不尽量把代码块建得很大<br />
        <b>1</b>：尽量把动态重编译块建得很大<br />
        <b>2</b>：把代码块建得更大（块重叠时继续，但只针对 ELF 内存中的块）<br />
        <b>3</b>：把代码块建得更大（块重叠时继续，适用于所有内存类型）
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_strongmem"><![CDATA[
        强内存模型模拟<br /><br />
        <b>0</b>：不做特殊处理<br />
        <b>1</b>：写入内存时加入部分内存屏障（某些 MOV 指令）<br />
        <b>2</b>：在 1 的基础上，每次用 MOV 写内存都加内存屏障<br />
        <b>3</b>：在 2 的基础上，读取内存以及部分 SSE/SSE2 指令也加内存屏障
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_forward">构建代码块时允许的最大前向值</string>
